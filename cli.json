{
  "_comment": "LLM provider catalog for bizagent-agent. Keys are LLM brands (not coding CLIs). Each entry is an OpenAI-compatible HTTP endpoint + models.",
  "_runtime": {
    "executable": "scripts/bizagent-agent",
    "promptFlag": "-f",
    "flags": {
      "extra": "-y"
    }
  },
  "grok": {
    "label": "Grok",
    "baseURL": "https://api.x.ai/v1",
    "keyEnv": "XAI_API_KEY",
    "models": [
      "grok-4.5",
      "grok-build-0.1",
      "grok-4.20-0309-reasoning",
      "grok-4.20-multi-agent-0309",
      "grok-4.3",
      "grok-4.6"
    ]
  },
  "chatgpt": {
    "label": "ChatGPT",
    "baseURL": "https://api.openai.com/v1",
    "keyEnv": "OPENAI_API_KEY",
    "models": [
      "gpt-5.4",
      "gpt-5.4-mini",
      "gpt-4o",
      "gpt-5.6-sol",
      "gpt-5.6-terra",
      "gpt-5.6-luna",
      "gpt-5.5",
      "gpt-5.2",
      "gpt-5.3",
      "gpt-5.6"
    ]
  },
  "claude": {
    "label": "Claude",
    "baseURL": "https://api.anthropic.com/v1/",
    "keyEnv": "ANTHROPIC_API_KEY",
    "models": [
      "claude-sonnet-4-6",
      "claude-opus-5",
      "claude-sonnet-4",
      "claude-haiku-4-5-20251001",
      "claude-opus-4-6",
      "claude-sonnet-4-7",
      "claude-opus-4-7",
      "claude-sonnet-4-8",
      "claude-opus-4-8",
      "claude-sonnet-5",
      "claude-fable-5"
    ]
  },
  "gemini": {
    "label": "Gemini",
    "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "keyEnv": "GEMINI_API_KEY",
    "models": [
      "gemini-2.5-flash",
      "gemini-2.5-pro",
      "gemini-2.0-flash",
      "antigravity-preview-05-2026",
      "gemini-2.5-flash-lite",
      "gemini-3.1-flash-lite",
      "gemini-3-flash-preview",
      "gemini-3.5-flash",
      "gemini-3.1-pro-preview"
    ]
  },
  "venice": {
    "label": "Venice",
    "baseURL": "https://api.venice.ai/api/v1",
    "keyEnv": "VENICE_API_KEY",
    "models": [
      "kimi-k2-7-code",
      "qwen3-5-9b",
      "kimi-k2-6",
      "kimi-k2-5",
      "deepseek-v3.2",
      "deepseek-v4-flash-0731",
      "deepseek-v4-pro-0813",
      "qwen-3-8-27b",
      "qwen-3-8-2-4t-a95b",
      "google-gemma-4-31b-it",
      "zai-org-glm-5-2",
      "zai-org-glm-5-1",
      "zai-org-glm-5",
      "z-ai-glm-5-3-flash",
      "z-ai-glm-5-3",
      "kimi-k3",
      "kimi-k3-fast-api"
    ]
  },
  "ollama": {
    "label": "Ollama (Jobe)",
    "baseURL": "http://<ollama-host>:11434/v1",
    "keyEnv": "OLLAMA_API_KEY",
    "optionalKey": true,
    "models": [
      "qwen2.5:7b",
      "qwen2.5:14b",
      "qwen2.5:latest",
      "qwen3:8b",
      "qwen3:14b",
      "qwen3:30b",
      "qwen3.8:27b",
      "deepseek-coder-v2:16b",
      "jobe:latest",
      "jobe-brain-v15-7b:latest",
      "jobe-brain-v14-7b:latest",
      "jobe-prompt-qwen:latest",
      "jobe-prompt-deepseek:latest"
    ]
  },
  "localhost": {
	"label": "Ollama (localhost)",
	"baseURL": "http://localhost:11434/v1",
	"keyEnv": "OLLAMA_API_KEY",
	"optionalKey": true,
	"models": []
  }
}
