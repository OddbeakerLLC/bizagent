{
  "_comment": "LLM provider catalog for bizagent-agent. Keys are LLM brands (not coding CLIs). Each entry is an OpenAI-compatible HTTP endpoint + models.",
  "_runtime": {
    "executable": "scripts/bizagent-agent",
    "promptFlag": "-f",
    "flags": {
      "extra": "-y"
    }
  },
  "grok": {
    "label": "Grok",
    "baseURL": "https://api.x.ai/v1",
    "keyEnv": "XAI_API_KEY",
    "models": [
      "grok-build-0.1",
      "grok-4.20-0309-reasoning",
      "grok-4.20-multi-agent-0309",
      "grok-4.3",
      "grok-4.5"
    ]
  },
  "chatgpt": {
    "label": "ChatGPT",
    "baseURL": "https://api.openai.com/v1",
    "keyEnv": "OPENAI_API_KEY",
    "models": [
      "gpt-5.2",
      "gpt-5.3",
      "gpt-5.4-mini",
      "gpt-5.4",
      "gpt-5.5"
    ]
  },
  "claude": {
    "label": "Claude",
    "baseURL": "https://api.anthropic.com/v1/",
    "keyEnv": "ANTHROPIC_API_KEY",
    "models": [
      "claude-haiku-4-5-20251001",
      "claude-sonnet-4-6",
      "claude-opus-4-6",
      "claude-sonnet-4-7",
      "claude-opus-4-7",
      "claude-sonnet-4-8",
      "claude-opus-4-8",
      "claude-sonnet-5",
      "claude-opus-5",
      "claude-fable-5"
    ]
  },
  "gemini": {
    "label": "Gemini",
    "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "keyEnv": "GEMINI_API_KEY",
    "models": [
      "antigravity-preview-05-2026",
      "gemini-2.5-pro",
      "gemini-2.5-flash-lite",
      "gemini-3.1-flash-lite",
      "gemini-3-flash-preview",
      "gemini-3.5-flash",
      "gemini-3.1-pro-preview",
    ]
  },
  "venice": {
    "label": "Venice",
    "baseURL": "https://api.venice.ai/api/v1",
    "keyEnv": "VENICE_API_KEY",
    "models": [
      "deepseek-v4-flash-0731",
      "kimi-k2-5",
      "kimi-k2-6",
      "kimi-k2-7-code",
      "kimi-k3",
      "kimi-k3-fast-api",
      "qwen3-5-35b-a3b",
      "qwen3-6-27b",
      "qwen3-6-35b-a3b",
      "zai-org-glm-5",
      "zai-org-glm-5-2"
    ]
  },
  "ollama": {
    "label": "Ollama (local)",
    "baseURL": "http://127.0.0.1:11434/v1",
    "keyEnv": "OLLAMA_API_KEY",
    "optionalKey": true,
    "models": [
      "llama3.2"
    ]
  }
}
