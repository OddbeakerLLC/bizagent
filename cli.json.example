{
  "_comment": "CLI configuration. Standard CLI definitions (claude, codex, agy, grok) keyed by CLI name. Copy to cli.json and customize.",
  "claude": {
    "executable": "claude",
    "promptFlag": "-p",
    "flags": {
      "extra": "--dangerously-skip-permissions"
    },
    "models": [
      "claude-opus-5",
      "claude-fable-5",
      "claude-opus-4-8",
      "claude-opus-4-7",
      "claude-opus-4-6",
      "claude-opus-4-5",
      "claude-sonnet-5",
      "claude-sonnet-4-6",
      "claude-sonnet-4-5",
      "claude-opus-5-fast",
      "claude-opus-4-8-fast"
    ]
  },
  "codex": {
    "executable": "codex",
    "promptFlag": "--prompt",
    "flags": {
      "extra": "--full-auto"
    },
    "models": [
      "gpt-5.6-sol",
      "gpt-5.6-terra",
      "gpt-5.6-luna",
      "gpt-5.5",
      "gpt-5.4",
      "gpt-5.4-mini",
      "gpt-5.2"
    ]
  },
  "agy": {
    "executable": "agy",
    "promptFlag": "-p",
    "flags": {
      "extra": "--dangerously-skip-permissions"
    },
    "models": [
      "gemini-3.6-flash-high",
      "gemini-3.6-flash-medium",
      "gemini-3.6-flash-low",
      "gemini-3.5-flash-high",
      "gemini-3.5-flash-medium",
      "gemini-3.5-flash-low",
      "gemini-3.1-pro-high",
      "gemini-3.1-pro-low"
    ]
  },
  "grok": {
    "executable": "grok",
    "promptFlag": "--prompt-file",
    "flags": {
      "extra": "--always-approve"
    },
    "models": [
      "grok-4.5"
    ]
  },
  "venice": {
    "executable": "venice-code",
    "promptFlag": "-f",
    "flags": {
      "extra": "-y"
    },
    "models": [
      "deepseek-v3.2",
      "deepseek-v4-flash-0731",
      "kimi-k2-5",
      "kimi-k2-6",
      "kimi-k2-7-code",
      "kimi-k3",
      "zai-org-glm-4.6",
      "zai-org-glm-4.7",
      "zai-org-glm-4.7-flash",
      "zai-org-glm-5",
      "zai-org-glm-5-1",
      "zai-org-glm-5-2"
    ]
  }
}
