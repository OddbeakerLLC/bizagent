{
  "_comment": "CLI configuration. Standard CLI definitions (claude, codex, agy, grok) keyed by CLI name. Copy to cli.json and customize.",
  "claude": {
    "executable": "claude",
    "promptFlag": "-p",
    "flags": {
      "extra": ""
    }
  },
  "codex": {
    "executable": "codex",
    "promptFlag": "--prompt",
    "flags": {
      "extra": ""
    }
  },
  "agy": {
    "executable": "agy",
    "promptFlag": "-p",
    "flags": {
      "extra": ""
    }
  },
  "grok": {
    "executable": "grok",
    "promptFlag": "--prompt-file",
    "flags": {
      "extra": "--always-approve"
    }
  }
}