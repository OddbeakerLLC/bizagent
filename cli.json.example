{
  "_comment": "CLI configuration keyed by CLI name (e.g., claude, codex, agy, grok). promptFlag is the flag that receives a prompt *file path*. Grok: use --prompt-file (not -p, which is prompt text). Claude/agy: -p. Codex: --prompt.",
  "claude": {
    "executable": "claude",
    "promptFlag": "-p",
    "flags": {
      "extra": ""
    }
  },
  "codex": {
    "executable": "codex",
    "promptFlag": "--prompt",
    "flags": {
      "extra": ""
    }
  },
  "agy": {
    "executable": "agy",
    "promptFlag": "-p",
    "flags": {
      "extra": ""
    }
  },
  "grok": {
    "executable": "grok",
    "promptFlag": "--prompt-file",
    "flags": {
      "extra": "--always-approve"
    }
  }
}
