{
  "_comment": "CLI configuration keyed by CLI name (e.g., claude, codex, agy). Each entry defines how to invoke that CLI.",
  "claude": {
    "executable": "claude",
    "flags": {
      "model": "--model claude-opus-4-8"
    },
    "yolo": "--dangerously-skip-permissions",
    "path": ".",
    "prompt": "-p"
  },
  "codex": {
    "executable": "codex",
    "flags": {
      "model": "--model codex-pro"
    },
    "yolo": "--skip-auth",
    "path": ".",
    "prompt": "--prompt"
  },
  "agy": {
    "executable": "agy",
    "flags": {
      "model": "--model claude-opus-4-8"
    },
    "yolo": "--dangerously-skip-permissions",
    "path": ".",
    "prompt": "-p"
  }
}
