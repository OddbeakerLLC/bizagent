{
  "_comment": "Operational registry for Oddbeaker LLC. Paths are relative to this hub directory.",
  "org": "Oddbeaker LLC",
  "hub": {
    "name": "BizAgent",
    "remote": "ssh://tmanso@sm00.oddbeaker.com/repo/git/bizagent-run.git"
  },
  "settings": {
    "nightly_time": "23:00",
    "archive_after_days": 30,
    "autonomy": "maintenance-only",
    "dispatch": {
      "_comment": "Node control-plane dispatch tunables. poll_seconds honored (default 2; clamp 1\u201330). hub_slots and agent_slots are separate pools so hub turns do not starve product fanout (defaults: hub 1, agents = max_concurrency). max_concurrency default 8 (product-agent pool when agent_slots omitted).",
      "poll_seconds": 2,
      "max_concurrency": 8,
      "hub_slots": 1,
      "agent_slots": 8,
      "lock_lease_secs": 1800
    },
    "control_plane": {
      "host": "0.0.0.0",
      "port": 8787
    },
    "hub_agent": {
      "_comment": "Optional hub PTL agent settings for control-plane launches. cliName references an entry in cli.json (e.g. claude, grok); empty falls back to .cli / default.",
      "prompt": "You are the hub PTL agent. Read inbox/*.md for incoming messages, process each one, then archive it. After processing all messages, send a single PushNotification with status=proactive summarizing what arrived and what you did.",
      "model": "kimi-k2-5",
      "cliName": "venice"
    },
    "models": {
      "_comment": "Default model for product agent launches. Per-product model field overrides this.",
      "agent_default": "kimi-k2-5"
    },
    "tuning": {
      "_comment": "Operational tunables. archive.retention_days default 15.",
      "archive": {
        "retention_days": 15,
        "prune_on_nightly": true,
        "keep_min_files_per_dir": 5
      },
      "logging": {
        "level": "info",
        "structured_enabled": true
      },
      "hub": {
        "prefer_warm_daemon": true,
        "warm_connect_timeout_ms": 500,
        "warm_turn_timeout_ms": 600000
      }
    }
  },
  "knowledge_stack": {
    "enabled": true,
    "refresh_day": "sunday",
    "refresh_time": "01:00"
  },
  "cross_product_edges": [
    [
      "beakernet",
      "jobe-ai"
    ]
  ],
