# Local operational hub — push everything except the categories below.
# (Public GitHub repo uses a different, stricter .gitignore.)

# --- Logs ---
logs/
*.log

# --- Inboxes ---
inbox/
agents/*/inbox/

# --- Outboxes ---
outbox/
agents/*/outbox/

# --- Password / secret files ---
*.key
*.pem
*_secret*
*secrets*
.bizagent/auth.json

# --- Environment variables ---
.env
*.env
!.bizagent/env.example
.bizagent/env
.bizagent/env.bak

# --- Runtime artifacts (pids, locks, sockets, transient state) ---
.bizagent/*.pid
.bizagent/*.sock
.bizagent/*.heartbeat
.bizagent/hub.lock/
.bizagent/dispatch-state/
.bizagent/pending-replies/
.bizagent/runtime-cwd/
.bizagent/defer/
.bizagent/operator-stop/
.bizagent/quarantine/
.bizagent/uploads/
.bizagent/backups/
.bizagent/thinking.json
.bizagent/sessions.json
.bizagent/active-conversation.json
.bizagent/last-agent-error.json
.bizagent/pending-agent-work.json
.bizagent/pending-hub-turns.json
.bizagent/health-state.json
.bizagent/health-chat-stamp.json
.bizagent/journal-fts.sqlite
.bizagent/helper-slots/
agents/*/.lock/
agents/*/.dispatch.md

# --- Dependencies ---
node_modules/

# --- Nested git repos (separate clones with their own remotes) ---
bizagent/

# --- OS / editor noise ---
.DS_Store
*.swp
*~
