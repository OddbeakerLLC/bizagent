# Detached from the public bizagent framework repo (see AGENT.md § 2,
# "First launch"). This is now a private, local-only operational hub, so
# registry.json / dispatch prompts / project sitemaps are tracked here —
# never re-add them to .gitignore or this hub loses its own history.
*.env
.env
*.key
*.pem
*_secret*
*secrets*

# Local scratch
*.log
*.lock
logs/
.bizagent/

# Dispatcher runtime artifacts (per-agent lock dirs, generated dispatch
# prompts, CLI choice) — mechanically regenerated from registry.json + the
# templates, so they don't need their own git history.
agents/*/.lock/
agents/*/.dispatch.md
.cli

# Operator-specific leak markers for publish-check (holds your private strings)
scripts/publish-check.patterns
