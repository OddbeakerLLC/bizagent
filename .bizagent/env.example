# Copy to .bizagent/env and fill in. Never commit .bizagent/env.
# Sourced by control-plane.sh, hub-daemon, and the systemd unit (EnvironmentFile).

# LLM provider keys (bizagent-agent uses the key for hub_agent.provider)
# XAI_API_KEY=          # provider: grok
# OPENAI_API_KEY=       # provider: chatgpt
# ANTHROPIC_API_KEY=    # provider: claude
# GEMINI_API_KEY=       # provider: gemini (GOOGLE_API_KEY also accepted)
# VENICE_API_KEY=       # provider: venice
# OLLAMA_API_KEY=       # provider: ollama (optional; defaults to "ollama")

# Optional overrides (registry.json settings.control_plane is preferred for host/port)
# BIZAGENT_HOST=127.0.0.1
# BIZAGENT_PORT=8787
# BIZAGENT_HUB=

# llmapi REST API (installer sets this; dispatch routes through it when set).
# Port must match LLMAPI_PORT used by the llmapi service (default 8788).
# BIZAGENT_LLMAPI_URL=http://127.0.0.1:8788
# LLMAPI_PORT=8788
# LLMAPI_TOKEN=            # optional bearer token the API requires

# PlantUML / Graphviz (set by install.sh when using user-local tools)
# PLANTUML_SH=$HOME/.bizagent/tools/plantuml.sh
# GRAPHVIZ_DOT=$HOME/.bizagent/tools/bin/dot
# JAVA_HOME=$HOME/.bizagent/tools/jdk
# PATH=$HOME/.bizagent/tools/bin:$PATH

# Console TTS → oddbeaker-tts (Kokoro). Installer/upgrade may set these.
# UI toggle stays off until enabled in the browser (localStorage).
# BIZAGENT_TTS_URL=http://127.0.0.1:9201
# BIZAGENT_TTS_VOICE=af_heart
# BIZAGENT_TTS_TIMEOUT_MS=20000

