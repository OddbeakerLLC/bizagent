# Copy to .bizagent/env and fill in. Never commit .bizagent/env.
# Sourced by control-plane.sh, hub-daemon, and the systemd unit (EnvironmentFile).

# LLM provider keys (bizagent-agent uses the key for hub_agent.provider)
# XAI_API_KEY=          # provider: grok
# OPENAI_API_KEY=       # provider: chatgpt
# ANTHROPIC_API_KEY=    # provider: claude
# GEMINI_API_KEY=       # provider: gemini (GOOGLE_API_KEY also accepted)
# VENICE_API_KEY=       # provider: venice
# OLLAMA_API_KEY=       # provider: ollama (optional; defaults to "ollama")

# Optional overrides (registry.json settings.control_plane is preferred for host/port)
# BIZAGENT_HOST=127.0.0.1
# BIZAGENT_PORT=8787
# BIZAGENT_HUB=
