# Copy to .bizagent/env and fill in. Never commit .bizagent/env.
# Sourced by control-plane.sh, hub-daemon, and the systemd unit (EnvironmentFile).

# LLM / CLI provider keys (whichever CLI agents you run)
# XAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional overrides (registry.json settings.control_plane is preferred for host/port)
# BIZAGENT_HOST=127.0.0.1
# BIZAGENT_PORT=8787
# BIZAGENT_HUB=
